# Cloudflare Pages redirect rules, copied into build/site/ by `npm run build`.
# Antora's start-page redirect at the site root is a meta-refresh stub with no
# description, which search engines flag; serve a real 301 instead. Cloudflare
# applies these rules before matching static assets, so the stub is never served.
/            /arcadedb/  301
/index.html  /arcadedb/  301
