    {{#if page.canonicalUrl}}
    <meta property="og:type" content="{{#if (eq page.url page.componentVersion.url)}}website{{else}}article{{/if}}">
    <meta property="og:site_name" content="{{plain site.title}}">
    <meta property="og:title" content="{{plain page.title}}">
    {{#with page.description}}
    <meta property="og:description" content="{{plain this}}">
    {{/with}}
    <meta property="og:url" content="{{page.canonicalUrl}}">
    <meta property="og:image" content="https://arcadedb.com/assets/images/arcadedb-logo.png">
    <meta property="og:locale" content="en_US">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{plain page.title}}">
    {{#with page.description}}
    <meta name="twitter:description" content="{{plain this}}">
    {{/with}}
    <script type="application/ld+json">
{{{jsonld}}}
    </script>
    {{/if}}
