<script>
  /* Apply the saved theme before the first paint, so a dark reader never sees a white flash.
     Keep the key in step with js/theme-toggle.js. No saved choice: the system setting decides (css). */
  try {
    var t = localStorage.getItem('arcadedb-docs-theme')
    if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t)
  } catch (e) {}
</script>
<link rel="stylesheet" href="{{uiRootPath}}/css/site.css">
<link rel="stylesheet" href="{{{siteRootPath}}}/pagefind/pagefind-ui.css">
<link rel="stylesheet" href="{{uiRootPath}}/css/arcadedb.css">
